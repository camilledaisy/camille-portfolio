---
const links = [
  { href: '/#work', label: 'Work' },
  { href: '/#about', label: 'About' },
  { href: '#', label: 'Resume', muted: true },
  { href: '/#contact', label: 'Contact' },
];
---

<header class="site-header">
  <div class="container inner">
    <a class="name" href="/">Camille Villanueva</a>
    <nav aria-label="Main">
      <ul>
        {
          links.map((link) => (
            <li>
              <a href={link.href} class:list={{ muted: link.muted }}>
                {link.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
  </div>
</header>

<style>
  .site-header {
    border-bottom: 1px solid var(--line);
    background: var(--bg);
  }
  .inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
    height: 56px;
  }
  .name {
    font-weight: 500;
    font-size: 15px;
    white-space: nowrap;
  }
  ul {
    display: flex;
    gap: 24px;
    list-style: none;
    margin: 0;
    padding: 0;
    font-size: 14px;
  }
  a {
    transition: opacity 0.2s ease;
  }
  a:hover {
    opacity: 0.6;
  }
  .muted {
    color: var(--text-muted);
  }
  @media (max-width: 560px) {
    ul {
      gap: 12px;
      font-size: 13px;
    }
    .name {
      font-size: 14px;
    }
  }
</style>
