---
import * as icons from 'lucide-static';

interface Props {
  name: keyof typeof icons;
  size?: number;
  class?: string;
}

const { name, size = 20, class: className } = Astro.props;
const svg = (icons[name] as string)
  .replace(/width="24"/, `width="${size}"`)
  .replace(/height="24"/, `height="${size}"`)
  .replace(/stroke-width="2"/, 'stroke-width="1.5"')
  .replace('<svg', '<svg aria-hidden="true"');
---

<span class:list={['icon', className]}><Fragment set:html={svg} /></span>

<style>
  .icon {
    display: inline-flex;
    line-height: 0;
  }
</style>
