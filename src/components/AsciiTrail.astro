---
// Wraps an image with a canvas that leaves a trail of small dithered dots
// behind the cursor. Dots thin out randomly as the trail fades.
interface Props {
  class?: string;
}

const { class: className } = Astro.props;
---

<div class:list={['ascii-trail', className]}>
  <slot />
  <canvas aria-hidden="true"></canvas>
</div>

<style>
  .ascii-trail {
    position: relative;
    overflow: hidden;
    touch-action: pan-y;
  }
  .ascii-trail :global(img) {
    display: block;
  }
  canvas {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
  }
</style>

<script>
  const CELL = 6; // grid spacing in CSS px
  const DOT = 2; // dot size in CSS px
  const RADIUS = 5; // brush radius in cells
  const DECAY = 0.984; // how fast the trail fades each frame (~2s)
  const FLICKER = 0.04; // share of dots that re-roll their threshold each frame
  const COLOR = 'rgba(255, 255, 255, 0.95)';

  function setup(root: HTMLElement) {
    const canvas = root.querySelector('canvas');
    const ctx = canvas?.getContext('2d');
    if (!canvas || !ctx) return;

    let cols = 0;
    let rows = 0;
    let heat = new Float32Array(0);
    // Each dot shows once the trail's heat passes its own random threshold,
    // which gives the dithered, dissolving edge as the trail fades.
    let threshold = new Float32Array(0);
    let last: { x: number; y: number } | null = null;
    let running = false;

    function resize() {
      const rect = root.getBoundingClientRect();
      const dpr = window.devicePixelRatio || 1;
      canvas!.width = Math.round(rect.width * dpr);
      canvas!.height = Math.round(rect.height * dpr);
      ctx!.setTransform(dpr, 0, 0, dpr, 0, 0);

      cols = Math.ceil(rect.width / CELL);
      rows = Math.ceil(rect.height / CELL);
      heat = new Float32Array(cols * rows);
      threshold = new Float32Array(cols * rows);
      for (let i = 0; i < threshold.length; i++) threshold[i] = 0.12 + Math.random() * 0.88;
    }

    function paint(cx: number, cy: number) {
      const r = Math.ceil(RADIUS);
      const ix = Math.round(cx);
      const iy = Math.round(cy);
      for (let y = iy - r; y <= iy + r; y++) {
        if (y < 0 || y >= rows) continue;
        for (let x = ix - r; x <= ix + r; x++) {
          if (x < 0 || x >= cols) continue;
          const d = Math.hypot(x - cx, y - cy) / RADIUS;
          if (d > 1) continue;
          const i = y * cols + x;
          heat[i] = Math.max(heat[i], 0.85 * (1 - d * d * d));
        }
      }
    }

    function onMove(e: PointerEvent) {
      const rect = root.getBoundingClientRect();
      const x = (e.clientX - rect.left) / CELL;
      const y = (e.clientY - rect.top) / CELL;
      // Fill in the gap since the last event so fast moves leave a solid trail
      const from = last ?? { x, y };
      const steps = Math.max(1, Math.ceil(Math.hypot(x - from.x, y - from.y)));
      for (let s = 1; s <= steps; s++) {
        const t = s / steps;
        paint(from.x + (x - from.x) * t, from.y + (y - from.y) * t);
      }
      last = { x, y };
      start();
    }

    function frame() {
      ctx!.clearRect(0, 0, canvas!.width, canvas!.height);
      ctx!.fillStyle = COLOR;
      const offset = (CELL - DOT) / 2;

      let active = false;
      for (let i = 0; i < heat.length; i++) {
        const v = heat[i];
        if (v === 0) continue;
        if (v < 0.01) {
          heat[i] = 0;
          continue;
        }
        active = true;
        heat[i] = v * DECAY;
        if (Math.random() < FLICKER) threshold[i] = 0.12 + Math.random() * 0.88;
        if (v > threshold[i]) {
          const x = (i % cols) * CELL + offset;
          const y = Math.floor(i / cols) * CELL + offset;
          ctx!.fillRect(x, y, DOT, DOT);
        }
      }

      if (active) {
        requestAnimationFrame(frame);
      } else {
        running = false;
      }
    }

    function start() {
      if (running) return;
      running = true;
      requestAnimationFrame(frame);
    }

    resize();
    new ResizeObserver(resize).observe(root);
    root.addEventListener('pointermove', onMove);
    root.addEventListener('pointerleave', () => (last = null));
  }

  if (!window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
    document.querySelectorAll<HTMLElement>('.ascii-trail').forEach(setup);
  }
</script>
